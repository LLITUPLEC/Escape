prokrust-play.ru {
    encode gzip
    header {
        -Server
        X-Content-Type-Options nosniff
    }
    redir /escape /escape/ 308
    handle_path /escape/downloads/* {
        root * /var/www/escape/downloads
        header Cache-Control "public, max-age=31536000, immutable"
        header Content-Type "application/vnd.android.package-archive"
        file_server
    }
    handle_path /escape/* {
        root * /var/www/escape/current
        header Cache-Control "no-cache"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:27350 {
            header_up X-Real-IP {remote_host}
            stream_close_delay 5m
        }
    }
}

console.prokrust-play.ru {
    encode gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy 127.0.0.1:27352 {
        header_up X-Real-IP {remote_host}
    }
}
