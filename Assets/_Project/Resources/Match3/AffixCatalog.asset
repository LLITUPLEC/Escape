    icon: {fileID: 21300000, guid: 6da092bf114f49548b0799f3786ce2f0, type: 3}
  - id: frozen
    title: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439"
    description: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0441\u0442\u043E\u044F\u0442 \u043D\u0430 10 \u043C\u0430\u043D\u044B \u0434\u043E\u0440\u043E\u0436\u0435."
    icon: {fileID: 21300000, guid: 03f729f742b07574cb85b2dbbe47019a, type: 3}
  - id: monster_rage
    title: "\u042F\u0440\u043E\u0441\u0442\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u0430"
    description: "\u041A\u0430\u0436\u0434\u0430\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u043C \u0431\u043E\u043C\u0431\u0430
      \u0434\u0430\u0451\u0442 \u0435\u043C\u0443 +3 \u0443\u0440\u043E\u043D\u0430
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0431\u043E\u044F."
    icon: {fileID: 21300000, guid: b2780f148d096284caea37ac3c587626, type: 3}
  - id: instability
    title: "\u041D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    description: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0442\u0432\u043E\u0435\u0433\u043E \u0445\u043E\u0434\u0430 \u043A\u0430\u043C\u043D\u0438
      \u043D\u0430 \u043F\u043E\u043B\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0438\u0432\u0430\u044E\u0442\u0441\u044F."
    icon: {fileID: 21300000, guid: f1eb0184b7f16594bbce9a5f3ff4a2ec, type: 3}
  - id: overload
    title: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430"
    description: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043C\u0430\u043D\u044B
      \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E 1 \u0437\u0430
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u0430\u0451\u0442 \u043C\u0430\u043D\u0443."
    icon: {fileID: 21300000, guid: ecf590e2bc016c84bafec690e54735be, type: 3}
  - id: bare_current
    title: "\u0413\u043E\u043B\u044B\u0439 \u0442\u043E\u043A"
    description: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043C\u0430\u043D\u044B
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E (\u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E), \u043D\u043E \u0443\u0440\u043E\u043D
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0432\u0434\u0432\u043E\u0439\u043D\u0435."
    icon: {fileID: 21300000, guid: 58251126ea541f64ab38064068971e20, type: 3}
  - id: scree
    title: "\u041E\u0441\u044B\u043F\u044C"
    description: "\u0412\u0440\u0435\u043C\u044F \u0445\u043E\u0434\u0430 \u0443\u043C\u0435\u043D\u044C\u0448\u0435\u043D\u043E
      \u0432 3 \u0440\u0430\u0437\u0430 (10 \u0441\u0435\u043A\u0443\u043D\u0434)."
