  affixes:
  - id: acid
    title: "\u041A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0439"
    description: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0442\u0432\u043E\u0435\u0433\u043E \u0445\u043E\u0434\u0430 \u0442\u0435\u0440\u044F\u0435\u0448\u044C
      3% \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0425\u041F."
    icon: {fileID: 21300000, guid: 3f9110e28a7a4c44d80ba02c2b0f0960, type: 3}
  - id: energy_block
    title: "\u042D\u043D\u0435\u0440\u0433\u043E\u0431\u043B\u043E\u043A"
    description: "\u0411\u043E\u043C\u0431\u044B \u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u044F\u0442
      \u0443\u0440\u043E\u043D \u0438 \u0434\u0430\u044E\u0442 +5 \u043A \u0443\u0440\u043E\u043D\u0443
      \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043D\u0443\u044E
      \u0431\u043E\u043C\u0431\u0443."
    icon: {fileID: 21300000, guid: 65a095bed9c351c43a5b7a0c7ca6a1ed, type: 3}
  - id: regeneration
    title: "\u0420\u0435\u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u044F"
    description: "\u041C\u043E\u043D\u0441\u0442\u0440 \u043B\u0435\u0447\u0438\u0442
      3% \u0425\u041F \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0432\u043E\u0439
      \u0445\u043E\u0434."
    icon: {fileID: 21300000, guid: c5098f361f7e195468638b030748a2fd, type: 3}
  - id: fragility
    title: "\u0425\u0440\u0443\u043F\u043A\u043E\u0441\u0442\u044C"
    description: "\u0423 \u043C\u043E\u043D\u0441\u0442\u0440\u0430 \u0432\u0434\u0432\u043E\u0435
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0425\u041F, \u043D\u043E +50 \u043C\u0430\u043D\u044B
      \u0438 +35% \u043A\u0440\u0438\u0442\u0430."
    icon: {fileID: 21300000, guid: 55ac7336effd49648a62de26aa40ca34, type: 3}
  - id: stone_skin
    title: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u0436\u0430"
    description: "\u041C\u043E\u043D\u0441\u0442\u0440 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      +15 \u0431\u0440\u043E\u043D\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0441\u0432\u043E\u0439 \u0445\u043E\u0434."
    icon: {fileID: 21300000, guid: 1f1efeab962ce4b498070979a21ef530, type: 3}
  - id: mana_vampire
    title: "\u041C\u0430\u043D\u0430-\u0432\u0430\u043C\u043F\u0438\u0440"
    description: "\u041A\u0430\u0436\u0434\u0430\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u043A\u0430\u043F\u0441\u0443\u043B\u0430 \u0434\u0430\u0451\u0442 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443
