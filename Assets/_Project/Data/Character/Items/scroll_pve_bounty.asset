  displayName: "\u0421\u0432\u0438\u0442\u043e\u043a \u0449\u0435\u0434\u0440\u043e\u0439 \u0434\u043e\u0431\u044b\u0447\u0438"
  colorDisplayName: {r: 1, g: 1, b: 1, a: 1}
  description: "\u041d\u0430 1 \u0447\u0430\u0441 \u0441 \u043c\u043e\u043c\u0435\u043d\u0442\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u043e\u0439 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438: \u0437\u043e\u043b\u043e\u0442\u043e \u0438 \u0440\u0443\u0434\u0430 PvE \u00d71,5. \u0423\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043d\u043e\u0432\u044b\u0445 \u0431\u043e\u044f\u0445, \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0445 \u0434\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f. \u0421 \u0430\u0443\u0440\u043e\u0439 \u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0438\u0439 \u0431\u043e\u043d\u0443\u0441. \u041d\u0435 \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u043e\u043f\u044b\u0442, \u043c\u0430\u0442\u0435\u0440\u0438\u044e, \u0448\u0430\u043d\u0441 \u0434\u043e\u0431\u044b\u0447\u0438, \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0438 \u0430\u0440\u0435\u043d\u0443."
